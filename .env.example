# Use snapshot data from DATA_DIR instead of invented fixtures.
ORDER_SOURCE=snapshot
# Azure storage account name (no URL).
ORDER_BLOB_ACCOUNT=yourstorageaccount
# Blob container that holds the Matrixify CSV.
ORDER_BLOB_CONTAINER=yourcontainer
# Blob name Matrixify overwrites each hour.
ORDER_BLOB_NAME=order_lookup.csv
# Directory for the on-disk snapshot JSON.
DATA_DIR=./data
